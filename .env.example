NODE_ENV=development

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=NovaOrgBot
# Production bot service only. URL is the public Cloud Run service base URL.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Public URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:5174

# Datastores
DATABASE_URL=postgresql://nova:nova@localhost:5432/nova_org
REDIS_URL=redis://localhost:6379

# Secrets — generate strong random values, never commit real values
JWT_SECRET=change-me-to-a-random-32-char-secret
SESSION_SECRET=change-me-to-a-random-32-char-secret
WORK_SIGNING_SECRET=change-me-to-a-random-32-char-secret

# Shared secret between the bot process and the API's internal endpoints
# (wallet/reward reads and mutations). Never expose this to the Mini App.
INTERNAL_API_SECRET=change-me-to-a-random-32-char-secret

# Coin economy (Phase 2, bot-only surface)
DAILY_REWARD_AMOUNT=50
REFERRAL_REWARD_AMOUNT=500

# Admin
ADMIN_TELEGRAM_IDS=

# Ports
API_PORT=4000
ADMIN_API_PORT=4001

# Set to 1 only when exactly one trusted reverse proxy is in front of the API
# and the API port is not directly exposed to the internet.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
