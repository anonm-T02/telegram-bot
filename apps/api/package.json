{
  "name": "@nova-org/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts test/**/*.test.ts",
    "start": "node --env-file=../../.env dist/index.js"
  },
  "dependencies": {
    "@nova-org/config": "0.1.0",
    "@nova-org/db": "0.1.0",
    "@nova-org/shared": "0.1.0",
    "@nova-org/validation": "0.1.0",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
