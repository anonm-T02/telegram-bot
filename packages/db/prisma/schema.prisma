// NOVA ORG database schema.
//
// Phase 2: Telegram identity/auth sessions and activity heartbeats, plus the
// existing bot-only coin surface. Coin balance is never shown or
// mutated from the Mini App in this phase — only the Telegram bot
// (via the API's internal, secret-protected endpoints) reads/writes it.
// See NOVA_ORG_AGENT_PLAN.md section 9 for the full target schema
// (devices, contribution_sessions, work_units, tasks, services, etc.),
// which lands in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  telegramId   BigInt     @unique
  username     String?
  firstName    String?
  lastName     String?
  languageCode String?
  referralCode String     @unique
  referredById String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  referredBy              User?                    @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers           User[]                   @relation("UserReferrals")
  wallet                  Wallet?
  transactions            CoinTransaction[]
  dailyClaims             DailyClaim[]
  telegramSessions        TelegramSession[]
  activitySessions        ActivitySession[]
  deletionRequests        AccountDeletionRequest[]
  clickEvents             ClickEvent[]
  clickDailyCounters      ClickDailyCounter[]
  referralLink            ReferralLink?
  referralMilestones      ReferralMilestone[]      @relation("MilestoneBeneficiary")
  fraudSignals            FraudSignal[]
  riskScore               RiskScore?
  referralReleaseCounters ReferralReleaseCounter[]
  rewardRequests          RewardRequest[]
  adminUser               AdminUser?
  supportTickets          SupportTicket[]
  supportMessages         SupportMessage[]
  aiConversations         AiConversation[]
  adminLoginChallenges    AdminLoginChallenge[]
  cpuConsents             CpuConsent[]
  cpuSessions             CpuSession[]
  computeTasks            ComputeTask[]
  computeResults          ComputeResult[]

  referralsMade    Referral[] @relation("ReferrerRelation")
  referralReceived Referral?  @relation("ReferredRelation")
}

enum AccountDeletionRequestStatus {
  PENDING
  CANCELLED
  COMPLETED
}

model AccountDeletionRequest {
  id          String                       @id @default(cuid())
  userId      String
  user        User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  status      AccountDeletionRequestStatus @default(PENDING)
  reason      String?
  requestedAt DateTime                     @default(now())
  resolvedAt  DateTime?

  @@index([userId, status, requestedAt])
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

enum ActivityState {
  ONLINE
  ACTIVE
  IDLE
  BACKGROUND
  OFFLINE
}

enum ActivitySessionStatus {
  OPEN
  CLOSED
  EXPIRED
}

model TelegramSession {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String            @unique
  refreshTokenHash String?           @unique
  ipHash           String?
  userAgent        String?
  authenticatedAt  DateTime          @default(now())
  lastUsedAt       DateTime          @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  activitySessions ActivitySession[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model ActivitySession {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramSessionId String?
  telegramSession   TelegramSession?      @relation(fields: [telegramSessionId], references: [id], onDelete: SetNull)
  state             ActivityState         @default(ONLINE)
  status            ActivitySessionStatus @default(OPEN)
  isRewardable      Boolean               @default(false)
  activeSeconds     Int                   @default(0)
  startedAt         DateTime              @default(now())
  lastHeartbeatAt   DateTime              @default(now())
  endedAt           DateTime?
  heartbeats        Heartbeat[]
  clickEvents       ClickEvent[]

  @@unique([telegramSessionId])
  @@index([userId, status, lastHeartbeatAt])
  @@index([telegramSessionId])
  @@index([status, lastHeartbeatAt])
}

model Heartbeat {
  id                String          @id @default(cuid())
  activitySessionId String
  activitySession   ActivitySession @relation(fields: [activitySessionId], references: [id], onDelete: Cascade)
  state             ActivityState
  isVisible         Boolean
  clientSequence    Int
  receivedAt        DateTime        @default(now())

  @@unique([activitySessionId, clientSequence])
  @@index([activitySessionId, receivedAt])
  @@index([receivedAt])
}

model Wallet {
  id                            String                         @id @default(cuid())
  userId                        String                         @unique
  user                          User                           @relation(fields: [userId], references: [id])
  balance                       BigInt                         @default(0)
  lockedBalance                 BigInt                         @default(0)
  pendingBalance                BigInt                         @default(0)
  totalEarned                   BigInt                         @default(0)
  totalSpent                    BigInt                         @default(0)
  updatedAt                     DateTime                       @updatedAt
  transactions                  CoinTransaction[]
  referralPendingReconciliation ReferralPendingReconciliation?
  rewardRequests                RewardRequest[]
}

enum CoinTransactionType {
  DAILY_REWARD
  REFERRAL_REWARD
  ADMIN_GRANT
  CLICK_REWARD
  REFERRAL_MILESTONE_REWARD
  REWARD_LOCK
  REWARD_REFUND
  REWARD_REDEEM
}

model CoinTransaction {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id])
  walletId          String
  wallet            Wallet              @relation(fields: [walletId], references: [id], onDelete: Restrict)
  type              CoinTransactionType
  amount            BigInt
  referenceType     String?
  referenceId       String?
  metadata          Json?
  createdAt         DateTime            @default(now())
  clickEventId      String?             @unique
  clickEvent        ClickEvent?         @relation(fields: [clickEventId], references: [id], onDelete: Restrict)
  referralMilestone ReferralMilestone?
  rewardRequestId   String?
  rewardRequest     RewardRequest?      @relation(fields: [rewardRequestId], references: [id], onDelete: Restrict)

  @@unique([rewardRequestId, type])
  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([rewardRequestId, createdAt])
}

enum RewardRequestStatus {
  REQUESTED
  RISK_CHECK
  APPROVED
  QUEUED
  SENDING
  PAID
  REVIEW_REQUIRED
  FAILED
  REJECTED
  REFUNDED
}

enum RewardProviderType {
  TEST
  MANUAL
}

enum RewardTransactionStatus {
  CREATED
  SENDING
  SUCCEEDED
  FAILED
}

enum RewardBudgetPoolType {
  USER_REWARD
  DISPUTE
  TEST
  EMERGENCY
}

// One request consumes available microcoin by moving it to lockedBalance.
// requestDate and all monetary/reward values are server-authored.
model RewardRequest {
  id               String                    @id @default(cuid())
  userId           String
  user             User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletId         String
  wallet           Wallet                    @relation(fields: [walletId], references: [id], onDelete: Restrict)
  requestDate      DateTime                  @db.Date
  idempotencyKey   String                    @unique
  status           RewardRequestStatus       @default(REQUESTED)
  coinAmount       BigInt                    @default(100000)
  rewardUnits      Int                       @default(10)
  providerType     RewardProviderType        @default(TEST)
  failureCode      String?
  failureReason    String?
  metadata         Json?
  requestedAt      DateTime                  @default(now())
  riskCheckedAt    DateTime?
  approvedAt       DateTime?
  queuedAt         DateTime?
  sendingAt        DateTime?
  completedAt      DateTime?
  updatedAt        DateTime                  @updatedAt
  transactions     RewardTransaction[]
  transitions      RewardRequestTransition[]
  coinTransactions CoinTransaction[]

  @@unique([userId, requestDate])
  @@index([status, requestedAt])
  @@index([walletId, status])
}

// Provider delivery facts are separate from the internal coin ledger.
model RewardTransaction {
  id                String                  @id @default(cuid())
  rewardRequestId   String                  @unique
  rewardRequest     RewardRequest           @relation(fields: [rewardRequestId], references: [id], onDelete: Restrict)
  idempotencyKey    String                  @unique
  providerType      RewardProviderType
  status            RewardTransactionStatus @default(CREATED)
  rewardUnits       Int
  providerReference String?                 @unique
  attemptCount      Int                     @default(0)
  lastErrorCode     String?
  lastErrorMessage  String?
  createdAt         DateTime                @default(now())
  sendingAt         DateTime?
  sentAt            DateTime?
  updatedAt         DateTime                @updatedAt

  @@index([status, createdAt])
}

// Append-only audit trail for every state-machine mutation.
model RewardRequestTransition {
  id              String               @id @default(cuid())
  rewardRequestId String
  rewardRequest   RewardRequest        @relation(fields: [rewardRequestId], references: [id], onDelete: Restrict)
  fromStatus      RewardRequestStatus?
  toStatus        RewardRequestStatus
  actorType       String
  actorId         String?
  reason          String?
  metadata        Json?
  createdAt       DateTime             @default(now())

  @@index([rewardRequestId, createdAt])
}

// Daily reservation closes the concurrent 50-unit/day budget race.
model RewardBudget {
  id            String   @id @default(cuid())
  budgetDate    DateTime @unique @db.Date
  dailyLimit    Int      @default(50)
  reservedUnits Int      @default(0)
  paidUnits     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Global 5,000-unit allocation split into explicit accounting pools.
model RewardBudgetPool {
  id             String               @id @default(cuid())
  type           RewardBudgetPoolType @unique
  allocatedUnits Int
  reservedUnits  Int                  @default(0)
  spentUnits     Int                  @default(0)
  updatedAt      DateTime             @updatedAt
}

// Runtime controls are JSON so admins can update values without deployment.
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AdminRole {
  SUPER_ADMIN
  OPERATOR
  REVIEWER
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

model AdminUser {
  id        String          @id @default(cuid())
  userId    String          @unique
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      AdminRole       @default(REVIEWER)
  status    AdminStatus     @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  auditLogs AdminAuditLog[]
}

enum AdminLoginChallengeStatus {
  PENDING
  APPROVED
  CONSUMED
  EXPIRED
}

model AdminLoginChallenge {
  id               String                    @id
  codeChallenge    String
  status           AdminLoginChallengeStatus @default(PENDING)
  approvedByUserId String?
  approvedByUser   User?                     @relation(fields: [approvedByUserId], references: [id], onDelete: Restrict)
  expiresAt        DateTime
  approvedAt       DateTime?
  consumedAt       DateTime?
  createdAt        DateTime                  @default(now())

  @@index([status, expiresAt])
  @@index([approvedByUserId, createdAt])
}

// Append-only record of every privileged mutation. Database triggers reject
// UPDATE and DELETE so application bugs cannot rewrite administrative history.
model AdminAuditLog {
  id             String    @id @default(cuid())
  adminId        String
  admin          AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)
  action         String
  entityType     String
  entityId       String
  idempotencyKey String    @unique
  before         Json?
  after          Json?
  metadata       Json?
  ipHash         String?
  createdAt      DateTime  @default(now())

  @@index([adminId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportActorType {
  USER
  ADMIN
  SYSTEM
}

model FaqArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  locale      String   @default("uz")
  question    String
  answer      String
  keywords    String[]
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, locale, sortOrder])
}

model SupportTicket {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  subject        String
  category       String
  status         SupportTicketStatus @default(OPEN)
  idempotencyKey String              @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  resolvedAt     DateTime?
  messages       SupportMessage[]

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

model SupportMessage {
  id        String           @id @default(cuid())
  ticketId  String
  ticket    SupportTicket    @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Restrict)
  actorType SupportActorType
  content   String
  createdAt DateTime         @default(now())

  @@index([ticketId, createdAt])
}

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id               String         @id @default(cuid())
  conversationId   String
  conversation     AiConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  requestId        String?        @unique
  replyToRequestId String?        @unique
  role             String
  content          String
  provider         String?
  toolName         String?
  metadata         Json?
  createdAt        DateTime       @default(now())

  @@index([conversationId, createdAt])
}

enum ClickEventStatus {
  ACCEPTED
  REJECTED
}

enum ClickRejectionCode {
  COOLDOWN
  DAILY_LIMIT
  SESSION_NOT_REWARDABLE
  SESSION_INACTIVE
  USER_INELIGIBLE
  RISK_REJECTED
}

// Append-only record of every well-formed click attempt. requestId is the
// idempotency key supplied by the client; all time and reward fields are set
// by the server. Database triggers in the migration reject UPDATE and DELETE.
model ClickEvent {
  id                String              @id @default(cuid())
  requestId         String              @unique
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  activitySessionId String
  activitySession   ActivitySession     @relation(fields: [activitySessionId], references: [id], onDelete: Restrict)
  status            ClickEventStatus
  rejectionCode     ClickRejectionCode?
  rewardAmount      BigInt              @default(0)
  clickDate         DateTime            @db.Date
  serverReceivedAt  DateTime            @default(now())
  acceptedAt        DateTime?
  transaction       CoinTransaction?

  @@index([userId, clickDate, status])
  @@index([activitySessionId, serverReceivedAt])
  @@index([serverReceivedAt])
}

// Transactionally upserted/locked by the click service. The unique key gives
// one server-authoritative counter per user and UTC date under concurrency.
model ClickDailyCounter {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  clickDate      DateTime  @db.Date
  acceptedCount  Int       @default(0)
  totalReward    BigInt    @default(0)
  lastAcceptedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, clickDate])
  @@index([clickDate, acceptedCount])
}

// One row per (user, UTC day) — the unique constraint is what makes the
// daily reward endpoint idempotent under concurrent/duplicate requests.
model DailyClaim {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  claimDate DateTime @db.Date
  amount    BigInt
  createdAt DateTime @default(now())

  @@unique([userId, claimDate])
}

enum ReferralStatus {
  PENDING
  ACTIVE
  QUALITY_QUEUED
  QUALIFIED
  REJECTED
  REWARDED
}

model Referral {
  id                 String              @id @default(cuid())
  referrerUserId     String
  referrer           User                @relation("ReferrerRelation", fields: [referrerUserId], references: [id])
  referredUserId     String              @unique
  referred           User                @relation("ReferredRelation", fields: [referredUserId], references: [id])
  status             ReferralStatus      @default(PENDING)
  reward             BigInt              @default(0)
  registeredAt       DateTime            @default(now())
  activeDayCount     Int                 @default(0)
  activeSeconds      Int                 @default(0)
  validClickCount    Int                 @default(0)
  qualityQualifiedAt DateTime?
  riskCheckedAt      DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  updatedAt          DateTime            @updatedAt
  createdAt          DateTime            @default(now())
  milestones         ReferralMilestone[]

  @@index([referrerUserId, status, createdAt])
  @@index([status, qualityQualifiedAt])
}

// Canonical, revocable deep-link identity. User.referralCode remains during
// the compatibility window; the migration backfills exactly one link/user.
model ReferralLink {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  code      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([code, isActive])
}

enum ReferralMilestoneType {
  REFERRER_REGISTER
  REFERRER_ACTIVE_3_DAYS
  REFERRER_QUALITY_7_DAYS
  REFERRED_USER_QUALITY
}

enum ReferralMilestoneStatus {
  PENDING
  ELIGIBLE
  QUEUED
  RELEASED
  REJECTED
}

model ReferralMilestone {
  id              String                  @id @default(cuid())
  referralId      String
  referral        Referral                @relation(fields: [referralId], references: [id], onDelete: Restrict)
  beneficiaryId   String
  beneficiary     User                    @relation("MilestoneBeneficiary", fields: [beneficiaryId], references: [id], onDelete: Restrict)
  type            ReferralMilestoneType
  status          ReferralMilestoneStatus @default(PENDING)
  amount          BigInt
  idempotencyKey  String                  @unique
  eligibleAt      DateTime?
  queuedAt        DateTime?
  releaseDate     DateTime?               @db.Date
  releasedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  transactionId   String?                 @unique
  transaction     CoinTransaction?        @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([referralId, type])
  @@index([beneficiaryId, status, eligibleAt])
  @@index([status, releaseDate, queuedAt])
}

// Locked once per referrer/day while releasing quality milestones. This is
// the database-side concurrency primitive for the maximum five daily releases.
model ReferralReleaseCounter {
  id            String   @id @default(cuid())
  referrerId    String
  referrer      User     @relation(fields: [referrerId], references: [id], onDelete: Restrict)
  releaseDate   DateTime @db.Date
  releasedCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([referrerId, releaseDate])
  @@index([releaseDate, releasedCount])
}

// One-time auditable reconciliation for Phase 4 legacy pending obligations.
// This is not an earned/available coin transaction and therefore does not
// create a CoinTransaction ledger row.
model ReferralPendingReconciliation {
  id                    String                   @id @default(cuid())
  walletId              String                   @unique
  wallet                Wallet                   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  outstandingObligation BigInt
  balanceBefore         BigInt
  amountApplied         BigInt
  balanceAfter          BigInt
  migrationKey          String                   @unique
  metadata              Json?
  createdAt             DateTime                 @default(now())
  reversal              ReferralPendingReversal?

  @@index([createdAt])
}

model ReferralPendingReversal {
  id                String                        @id @default(cuid())
  reconciliationId  String                        @unique
  reconciliation    ReferralPendingReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  walletId          String
  phantomObligation BigInt
  validOutstanding  BigInt
  balanceBefore     BigInt
  amountReversed    BigInt
  balanceAfter      BigInt
  migrationKey      String                        @unique
  metadata          Json?
  createdAt         DateTime                      @default(now())

  @@index([walletId, createdAt])
}

enum FraudSignalType {
  SHARED_IP
  SHARED_DEVICE
  IMPOSSIBLE_ACTIVITY
  CLICK_PATTERN
  REFERRAL_CLUSTER
  SESSION_ANOMALY
  MANUAL
}

enum FraudSignalStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model FraudSignal {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  type        FraudSignalType
  status      FraudSignalStatus @default(OPEN)
  weight      Int
  source      String
  fingerprint String?
  metadata    Json?
  detectedAt  DateTime          @default(now())
  expiresAt   DateTime?
  resolvedAt  DateTime?

  @@index([userId, status, detectedAt])
  @@index([type, fingerprint, detectedAt])
  @@index([status, expiresAt])
}

enum RiskLevel {
  NORMAL
  WATCH
  REVIEW_REQUIRED
  TEMPORARY_REWARD_HOLD
}

model RiskScore {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  score        Int       @default(0)
  level        RiskLevel @default(NORMAL)
  reasons      Json?
  modelVersion String
  calculatedAt DateTime  @default(now())
  holdUntil    DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([level, score, calculatedAt])
}

enum CpuConsentStatus {
  GRANTED
  REVOKED
  EXPIRED
}

enum CpuConsentAction {
  GRANT
  REVOKE
}

// Explicit, scoped permission for safe in-repository benchmarks. A consent is
// never inferred from login, clicks, heartbeat, or an earlier session.
model CpuConsent {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  clientInstanceHash String
  policyVersion      String
  status             CpuConsentStatus  @default(GRANTED)
  maxWorkers         Int               @default(1)
  maxDutyCyclePct    Int               @default(25)
  maxTaskSeconds     Int               @default(15)
  allowOnBattery     Boolean           @default(false)
  grantedAt          DateTime          @default(now())
  expiresAt          DateTime
  revokedAt          DateTime?
  revokeReason       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  events             CpuConsentEvent[]
  sessions           CpuSession[]

  @@index([userId, status, expiresAt])
  @@index([clientInstanceHash, status])
}

// Immutable evidence for explicit grant/revoke actions and retry safety.
model CpuConsentEvent {
  id             String           @id @default(cuid())
  consentId      String
  consent        CpuConsent       @relation(fields: [consentId], references: [id], onDelete: Restrict)
  action         CpuConsentAction
  idempotencyKey String           @unique
  policyVersion  String
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@index([consentId, createdAt])
}

enum CpuSessionStatus {
  ACTIVE
  PAUSED
  STOPPED
  EXPIRED
  CONSENT_REVOKED
  HIDDEN_STOP
  THERMAL_STOP
  RESOURCE_STOP
}

enum ThermalState {
  UNKNOWN
  NOMINAL
  WARM
  HOT
  CRITICAL
}

model CpuSession {
  id                 String                  @id @default(cuid())
  userId             String
  user               User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  consentId          String
  consent            CpuConsent              @relation(fields: [consentId], references: [id], onDelete: Restrict)
  status             CpuSessionStatus        @default(ACTIVE)
  userInitiated      Boolean                 @default(true)
  isVisible          Boolean                 @default(true)
  maxWorkers         Int
  maxDutyCyclePct    Int
  maxTaskSeconds     Int
  startedAt          DateTime                @default(now())
  lastHeartbeatAt    DateTime                @default(now())
  expiresAt          DateTime
  endedAt            DateTime?
  cooldownEligibleAt DateTime?
  stopReason         String?
  issuedTaskCount    Int                     @default(0)
  completedTaskCount Int                     @default(0)
  validatedWorkUnits Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  tasks              ComputeTask[]
  results            ComputeResult[]
  observations       CpuSessionObservation[]

  @@index([userId, status, startedAt])
  @@index([consentId, status])
  @@index([status, lastHeartbeatAt])
}

// Client telemetry is advisory and is never sufficient to award coin.
model CpuSessionObservation {
  id              String       @id @default(cuid())
  cpuSessionId    String
  cpuSession      CpuSession   @relation(fields: [cpuSessionId], references: [id], onDelete: Restrict)
  isVisible       Boolean
  workerCount     Int
  dutyCyclePct    Int
  thermalState    ThermalState @default(UNKNOWN)
  batteryLevelPct Int?
  isCharging      Boolean?
  clientSequence  Int
  observedAt      DateTime
  receivedAt      DateTime     @default(now())

  @@unique([cpuSessionId, clientSequence])
  @@index([cpuSessionId, receivedAt])
}

enum ComputeTaskType {
  INTEGER_MIX_V1
}

enum ComputeTaskStatus {
  ISSUED
  COMPLETED
  EXPIRED
  REJECTED
}

// Only enum allowlisted algorithms implemented in this repository can be
// issued. There is deliberately no code, URL, binary, command, or WASM field.
model ComputeTask {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  cpuSessionId   String
  cpuSession     CpuSession        @relation(fields: [cpuSessionId], references: [id], onDelete: Restrict)
  type           ComputeTaskType
  version        Int
  nonce          String            @unique
  inputSeed      String
  iterations     Int
  expectedDigest String
  payloadHash    String
  signature      String
  status         ComputeTaskStatus @default(ISSUED)
  issuedAt       DateTime          @default(now())
  expiresAt      DateTime
  completedAt    DateTime?
  result         ComputeResult?

  @@index([userId, status, expiresAt])
  @@index([cpuSessionId, status, issuedAt])
  @@index([type, version, status])
}

enum ComputeValidationStatus {
  ACCEPTED
  INVALID_SIGNATURE
  EXPIRED
  REPLAYED
  WRONG_OUTPUT
  RESOURCE_LIMIT
  SESSION_INACTIVE
  CONSENT_INACTIVE
}

// Append-only server validation fact. Client-reported work never changes a
// wallet directly; later reward logic may consume ACCEPTED work only.
model ComputeResult {
  id               String                  @id @default(cuid())
  computeTaskId    String                  @unique
  computeTask      ComputeTask             @relation(fields: [computeTaskId], references: [id], onDelete: Restrict)
  userId           String
  user             User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  cpuSessionId     String
  cpuSession       CpuSession              @relation(fields: [cpuSessionId], references: [id], onDelete: Restrict)
  outputDigest     String
  elapsedMs        Int
  workerCount      Int
  validationStatus ComputeValidationStatus
  validatedUnits   Int                     @default(0)
  evidence         Json?
  submittedAt      DateTime                @default(now())
  validatedAt      DateTime                @default(now())

  @@index([userId, validationStatus, validatedAt])
  @@index([cpuSessionId, validatedAt])
}
