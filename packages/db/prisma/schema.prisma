// NOVA ORG database schema.
//
// Phase 1 (Foundation) only wires up the Prisma datasource/client.
// The full domain schema (users, wallets, coin_transactions, devices,
// contribution_sessions, work_units, tasks, referrals, services, admin_logs)
// is introduced in Phase 2 by AGENT 2 (Database + Auth), following
// NOVA_ORG_AGENT_PLAN.md section 9.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Placeholder model so `prisma generate` produces a usable client during
// Phase 1. Replace with the real schema (users, wallets, coin_transactions,
// devices, contribution_sessions, work_units, tasks, task_claims,
// referrals, services, service_usage, admin_logs) in Phase 2.
model AppMeta {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
}
